__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/

# Local scan output and real agent profiles. A profile describes exactly
# what an agent is allowed to do, so these stay out of the repo by default.
*.local.json
controls.json
out.html
scan-*.html

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Wrangler local state. The account cache names the Cloudflare account.
.wrangler/

# Markdown twins and their index, written into site/ by scripts/build_md.py
# during the build (build.sh). Never committed.
site/*.md
site/guides/*.md
site/llms-full.txt
site/md-catalog.json
