/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://static.ads-twitter.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://maidensail.com https://t.co https://analytics.twitter.com https://ads-twitter.com https://*.google-analytics.com https://*.googletagmanager.com; manifest-src 'self'; connect-src 'self' https://cloudflareinsights.com https://analytics.twitter.com https://t.co https://ads-twitter.com https://ads-api.twitter.com https://ads-api.x.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'
  # Strict-Transport-Security deliberately omitted. Enabling it is a one-way
  # door: browsers cache the policy, and `preload` ships inside Chrome and
  # Firefox and takes months to undo. Turn it on as a separate decision,
  # starting without `preload`, once the subdomain layout is settled.
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # The X and Google hosts above are reached only after a visitor allows ad
  # measurement or visit statistics (site/consent.js). The Google wildcards are
  # Google's own documented list for GA4, which serves from regional hosts.
  # Until then the page asks nothing of them.

# build.sh stamps every reference to these with ?v=<content hash>, so a
# changed file is a new URL and the old one can be cached for good. HTML
# keeps Pages' default, max-age=0 and must-revalidate, so a page always names
# the current hash.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/copy.js
  Cache-Control: public, max-age=31536000, immutable

/contact.js
  Cache-Control: public, max-age=31536000, immutable

/consent.js
  Cache-Control: public, max-age=31536000, immutable

/theme.js
  Cache-Control: public, max-age=31536000, immutable

/subscribe.js
  Cache-Control: public, max-age=31536000, immutable

/favicon-16.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og-*.png
  # The share card is meant to be shown on other sites (X, Slack, LinkedIn
  # previews load it directly), so it drops the same-origin policy above.
  ! Cross-Origin-Resource-Policy
  Cache-Control: public, max-age=86400
